{% extends sonata_block.templates.block_base %}

{% block block %}
    {% set results_count = pager ? pager.countResults() : 0 %}
    {% set has_results = results_count > 0 %}
    {% set current_page_results = has_results ? pager.currentPageResults : [] %}
    {% set visibility_class = 'sonata-search-result-' ~ (has_results ? 'show' : show_empty_boxes) %}

    <div class="col-lg-4 col-md-6 search-box-item {{ visibility_class }}">
        <div class="card mb-4 {{ visibility_class }}">
            <div class="card-header {{ visibility_class }}">
                {{ settings.icon|default('')|parse_icon }}
                <h3 class="card-title">
                    {% if admin.label is not empty %}
                        {{ admin.label|trans({}, admin.translationdomain) }}
                    {% endif %}
                </h3>

                <div class="card-tools float-end d-flex align-items-center gap-1">
                    {% if has_results %}
                        <span class="badge text-bg-primary">{{ results_count }}</span>
                    {% elseif admin.hasRoute('create') and admin.hasAccess('create') %}
                        <a href="{{ admin.generateUrl('create') }}" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-plus" aria-hidden="true"></i>
                        </a>
                    {% endif %}
                    {% if admin.hasRoute('list') and admin.hasAccess('list') %}
                        <a href="{{ admin.generateUrl('list') }}" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-list" aria-hidden="true"></i>
                        </a>
                    {% endif %}
                </div>

                <div class="matches">
                    {% for name, filter in filters %}
                        <a class="badge text-bg-primary text-decoration-none" href="{{ admin.generateUrl('list', {'filter': {(filter.formName): {'value': term}}}) }}">
                            {% if filter.translationDomain is same as(false) %}
                                {{ filter.label }}
                            {% else %}
                                {{ filter.label|trans({}, filter.translationDomain ?? admin.translationDomain) }}
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            </div>
            {% if has_results %}
                <div class="card-body p-0">
                    <ul class="nav flex-column sonata-search-result-list">
                        {% for result in current_page_results %}
                            {% if admin.hasRoute(admin_route) and admin.hasAccess(admin_route, result) %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ admin.generateObjectUrl(admin_route, result) }}">
                                        {{ admin.toString(result) }}
                                    </a>
                                </li>
                            {% else %}
                                <li class="nav-item"><span class="nav-link">{{ admin.toString(result) }}</span></li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            {% else %}
                <div class="card-body">
                    <p>
                        <em>{{ 'no_results_found'|trans({}, 'SonataAdminBundle') }}</em>
                    </p>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
